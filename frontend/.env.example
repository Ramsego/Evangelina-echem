# Leave unset in production — the frontend uses "/api" relative to its origin
# and the platform proxy routes it to the backend.
#
# Only set this if the backend and frontend are on different origins AND you
# cannot configure a reverse proxy:
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
#
# Note: this value is baked into the JS bundle at build time by Vite.
# Changing it requires a rebuild.
