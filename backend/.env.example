# ── Required in production ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (exact match).
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app

# ── Hosted environment ─────────────────────────────────────────────────────────
# Set ENV=development locally to enable /docs and /redoc.
ENV=production

# Set TRUST_PROXY=true when running behind a reverse proxy (Render, Fly, Railway,
# nginx). This makes rate limiting use X-Forwarded-For instead of the proxy IP.
# Leave unset or false if the backend is exposed directly to the internet.
TRUST_PROXY=true

# ── Optional tuning ────────────────────────────────────────────────────────────
UPLOADS_ENABLED=true
MAX_FILE_MB=20
MAX_TOTAL_MB=100
MAX_FILES=100
CACHE_TTL_S=3600
MAX_RANGE=500
